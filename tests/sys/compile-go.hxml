compile-each.hxml
-D go-sourceline-comments

--main Main
-L hx2go
--custom-target go=bin/go/sys

--next
--main TestArguments
-L hx2go
--custom-target go=bin/go/testArguments

--next
--main ExitCode
-L hx2go
--custom-target go=bin/go/exitCode

--next
--main UtilityProcess
-L hx2go
--custom-target go=bin/go/utilityProcess

--next
--cmd go build -C bin/go/testArguments/main .
--cmd go build -C bin/go/exitCode/main .
--cmd go build -C bin/go/utilityProcess/main .
